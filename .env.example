# Copy this file to ".env" in the repository root and set values.
# Do not commit ".env".
#
# For local Gradle runs: export variables from ".env" in your shell or use IDE env file support.
# For "docker compose up": place ".env" next to docker-compose.yml; Compose substitutes ${VAR} into the backend service environment block.
#
TYPEDATA_TOKEN=
TYPEDATA_ENABLED=false
