# Copy this file to ".env" in the repository root and set values.
# Do not commit ".env".
#
# Required for "docker compose up" (production stack on the server).
# For local dev with exposed ports, use docker-compose.dev.yml instead.

POSTGRES_DB=logistic
POSTGRES_USER=logistic
POSTGRES_PASSWORD=

JWT_SECRET=

CORS_ALLOWED_ORIGIN_PATTERNS=https://example.com,https://www.example.com

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

TYPEDATA_TOKEN=
TYPEDATA_ENABLED=false
