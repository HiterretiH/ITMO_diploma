# Local IDE / workspace (not shared)
.ide/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Office / LibreOffice: lock files while .docx (etc.) are open
.~lock.*
~$*

# Logs and temp
*.log
*.tmp
*.temp
*.swp
*~

# Local env / secrets (if placed at repo root)
.env
.env.*
!.env.example

# Docker local overrides
docker-compose.override.yml

# Manual document review artifacts
backend/manual-review-docs/

# Local timing report from DocumentGenerationTimingReportTest (under backend/ when tests run from backend)
backend/docs/document-generation-timing-baseline.txt

# Python
__pycache__/
*.py[cod]

# Gradle (local cache and probes)
.gradle/

# Generated by utilities/docx_to_pdf_template (keep source *.docx templates tracked)
*.form.docx

# XML-substitution POC output (utilities/check_docx_structure/generate_docx_xml_substitution.py)
utilities/check_docx_structure/out/

