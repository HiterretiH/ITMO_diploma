# Local IDE / workspace (not shared)
.ide/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Office / LibreOffice: lock files while .docx (etc.) are open
.~lock.*
~$*

# Logs and temp
*.log
*.tmp
*.temp
*.swp
*~

# Local env / secrets (if placed at repo root)
.env
.env.*
!.env.example

# Docker local overrides
docker-compose.override.yml

# Manual document review artifacts
backend/manual-review-docs/

# Python
__pycache__/
*.py[cod]

# Gradle (local cache and probes)
.gradle/

# Generated by utilities/docx_form_prep (keep source *.docx templates tracked)
*.form.docx

