### Logistic API (see api/openapi.yaml)
### Default seed user: admin / admin123 (ADMIN). Register creates USER.
### IntelliJ / VS Code HTTP Client: run requests top-to-bottom; capture @name responses for variables.

@baseUrl = http://localhost:8080
### Docker Compose maps backend to host port 7272:
# @baseUrl = http://localhost:7272

@adminUser = admin
@adminPass = admin123

### Auth: login (ADMIN)
# @name loginAdmin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "{{adminUser}}",
  "password": "{{adminPass}}"
}

###
@token = {{loginAdmin.response.body.token}}

### Session: current profile
GET {{baseUrl}}/api/v1/me
Authorization: Bearer {{token}}

### Admin: create user (roles: USER | ADMIN)
POST {{baseUrl}}/api/v1/admin/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "api_http_demo",
  "password": "demo_pass_1",
  "roles": ["USER"]
}

### Customers: list
GET {{baseUrl}}/api/v1/customers
Authorization: Bearer {{token}}

### Customers: create
# @name createCustomer
POST {{baseUrl}}/api/v1/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "shortName": "ООО Ромашка",
  "fullName": "Общество с ограниченной ответственностью «Ромашка»",
  "phone": "+7 (495) 100-01-01",
  "requisites": "ИНН 7701001001, р/с 40702810900000001001"
}

###
@customerId = {{createCustomer.response.body.id}}

### Session: trip form draft (optional customerId for scoped next order number)
GET {{baseUrl}}/api/v1/me/trip-form-draft?customerId={{customerId}}
Authorization: Bearer {{token}}

### Customers: get by id
GET {{baseUrl}}/api/v1/customers/{{customerId}}
Authorization: Bearer {{token}}

### Customers: saved places (kind required: LOAD | UNLOAD)
GET {{baseUrl}}/api/v1/customers/{{customerId}}/places?kind=LOAD
Authorization: Bearer {{token}}

### Customers: merged place suggestions (history + optional TypeData; q optional; external needs length >= 3 when TypeData on)
GET {{baseUrl}}/api/v1/customers/{{customerId}}/place-suggestions?kind=LOAD&q=Мос
Authorization: Bearer {{token}}

### Customers: update
PUT {{baseUrl}}/api/v1/customers/{{customerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "shortName": "ООО Ромашка",
  "fullName": "ООО «Ромашка» — обновлённое наименование",
  "phone": "+7 (495) 100-01-02",
  "requisites": "ИНН 7701001001, КПП 770101001"
}

### Performers: list
GET {{baseUrl}}/api/v1/performers
Authorization: Bearer {{token}}

### Performers: create
# @name createPerformer
POST {{baseUrl}}/api/v1/performers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "shortName": "АльфаТранс",
  "fullName": "ООО «Альфа транспортные перевозки»",
  "phone": "+7 (495) 700-70-01",
  "bankName": "ПАО «Примербанк»",
  "inn": "7707707707",
  "bik": "044525555",
  "kpp": "770701001",
  "paymentAccount": "40702810900000007007",
  "corrAccount": "30101810000000000555",
  "requisites": "ОГРН 1027707707707, юр. адрес: 101000, г. Москва"
}

###
@performerId = {{createPerformer.response.body.id}}

### Performers: get
GET {{baseUrl}}/api/v1/performers/{{performerId}}
Authorization: Bearer {{token}}

### Drivers: list
GET {{baseUrl}}/api/v1/drivers
Authorization: Bearer {{token}}

### Drivers: create (performerId required)
# @name createDriver
POST {{baseUrl}}/api/v1/drivers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "performerId": {{performerId}},
  "fullName": "Иванов Иван Иванович",
  "phone": "+7 (903) 111-11-11"
}

###
@driverId = {{createDriver.response.body.id}}

### Vehicles: list
GET {{baseUrl}}/api/v1/vehicles
Authorization: Bearer {{token}}

### Vehicles: create (performerId required)
# @name createVehicle
POST {{baseUrl}}/api/v1/vehicles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "performerId": {{performerId}},
  "brandModel": "Demo Truck",
  "plateNumber": "A001BC77",
  "type": "tractor"
}

###
@vehicleId = {{createVehicle.response.body.id}}

### Orders: list
GET {{baseUrl}}/api/v1/orders
Authorization: Bearer {{token}}

### Orders: create (customerId, performerId required; rest optional in API)
# @name createOrder
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerId": {{customerId}},
  "performerId": {{performerId}},
  "vehicleId": {{vehicleId}},
  "driverId": {{driverId}},
  "orderDate": "2026-05-15",
  "orderNumber": 1,
  "loadingPlace": "Москва, склад, ул. Складская, д. 1",
  "loadingContact": "+7 (900) 123-45-67, диспетчер погрузки",
  "unloadingPlace": "Санкт-Петербург, РЦ, пр. Обуховской Обороны, 120",
  "unloadingContact": "+7 (900) 765-43-21, ответственный на выгрузке",
  "tripCount": 1,
  "pricePerTrip": 1000.00,
  "totalPrice": 1000.00
}

###
@orderId = {{createOrder.response.body.id}}

### Orders: get
GET {{baseUrl}}/api/v1/orders/{{orderId}}
Authorization: Bearer {{token}}

### Orders: update (partial mask)
PUT {{baseUrl}}/api/v1/orders/{{orderId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "loadingContact": "+7 (900) 123-45-68, сменный диспетчер",
  "tripCount": 2,
  "totalPrice": 2000.00
}

### Orders: complete
POST {{baseUrl}}/api/v1/orders/{{orderId}}/complete
Authorization: Bearer {{token}}

### Orders: reopen
POST {{baseUrl}}/api/v1/orders/{{orderId}}/reopen
Authorization: Bearer {{token}}

### Documents: list descriptors for order
GET {{baseUrl}}/api/v1/orders/{{orderId}}/documents
Authorization: Bearer {{token}}

### Documents: download (format query required: DOCX | PDF)
GET {{baseUrl}}/api/v1/orders/{{orderId}}/documents/WAYBILL/file?format=PDF
Authorization: Bearer {{token}}

### Audit: events for order
GET {{baseUrl}}/api/v1/orders/{{orderId}}/audit-events
Authorization: Bearer {{token}}

### Orders: delete
DELETE {{baseUrl}}/api/v1/orders/{{orderId}}
Authorization: Bearer {{token}}

### Vehicles: delete (before performer if FK blocks performer delete)
DELETE {{baseUrl}}/api/v1/vehicles/{{vehicleId}}
Authorization: Bearer {{token}}

### Drivers: delete
DELETE {{baseUrl}}/api/v1/drivers/{{driverId}}
Authorization: Bearer {{token}}

### Customers: delete
DELETE {{baseUrl}}/api/v1/customers/{{customerId}}
Authorization: Bearer {{token}}

### Performers: delete
DELETE {{baseUrl}}/api/v1/performers/{{performerId}}
Authorization: Bearer {{token}}

### --- Optional (standalone): public register (201); pick a fresh username
# POST {{baseUrl}}/api/v1/auth/register
# Content-Type: application/json
#
# {
#   "username": "self_reg_001",
#   "password": "secret12"
# }
